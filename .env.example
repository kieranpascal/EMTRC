# Frontend build (Vite SPA) requires ZERO runtime secrets or client-side API keys.
#
# Optional Brevo email automation (for /functions/api/brevo-lead.ts on Cloudflare Pages):
# Add these as Encrypted Variables / Secrets inside Cloudflare Dashboard -> Settings -> Variables & Secrets.
# NEVER commit real API keys into Git or client-side code.
#
# BREVO_API_KEY=xkeysib-your-brevo-api-key-in-cloudflare-dashboard-only
# BREVO_SENDER_EMAIL=hello@emtrc.com
# BREVO_SENDER_NAME=emtrc London
# BREVO_NOTIFY_EMAIL=hello@emtrc.com
# BREVO_NEWSLETTER_LIST_ID=3
# BREVO_PDF_LIST_ID=4
# BREVO_ENQUIRY_LIST_ID=5
#
# Once those Cloudflare variables are saved, set endpoints in src/content/site.ts to '/api/brevo-lead'.
